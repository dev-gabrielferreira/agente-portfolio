# ======================= Agente de portfólio — configuração =======================
# Copie para .env (chmod 600). Nunca commite o .env.

# --- Acesso ao Claude (escolha UM) ---
# Assinatura Pro/Max: rode `claude setup-token` no seu computador e cole o token aqui.
CLAUDE_CODE_OAUTH_TOKEN=
# Alternativa pago por uso (tem prioridade se estiver definida — deixe vazia para usar a assinatura):
ANTHROPIC_API_KEY=

# --- Modelo ---
AGENT_MODEL=claude-opus-5-5
# Esforço de raciocínio: low | medium | high | xhigh | max
AGENT_EFFORT=high
AGENT_EVAL_EFFORT=high

# --- Painel ---
ADMIN_PASSWORD=troque-por-uma-senha-longa
# gere com: openssl rand -hex 32
SESSION_SECRET=
PANEL_URL=https://agent.gabrielfdev.com

# --- Domínio e infraestrutura ---
PORTFOLIO_DOMAIN=gabrielfdev.com
DOCKER_NETWORK=interna
CADDY_CONTAINER=caddy
CADDY_CONFIG_PATH=/etc/caddy/Caddyfile
# Senha do staging (opcional). Gere o hash com:
#   docker exec caddy caddy hash-password --plaintext 'sua-senha'
STAGING_AUTH_USER=gabriel
STAGING_AUTH_PASSWORD=
STAGING_AUTH_HASH=
CONTAINER_MEMORY=512m
CONTAINER_CPUS=1.0

# --- GitHub (token fine-grained: Contents RW + Administration RW nos seus repositórios) ---
GITHUB_OWNER=dev-gabrielferreira
GITHUB_TOKEN=
GIT_AUTHOR_NAME=Gabriel Ferreira (via agente)
GIT_AUTHOR_EMAIL=

# --- Harness: design, testes e MCPs ---
# Figma (oficial, com escrita no canvas). Depois do login único (README, passo "Figma"), mude para true.
FIGMA_ENABLED=false
# Plano da Figma onde o designer cria os arquivos (opcional; sem ele usa o único plano da conta)
FIGMA_PLAN_KEY=
# Context7 (documentação atualizada das bibliotecas). Funciona sem chave; com chave o limite é maior.
CONTEXT7_API_KEY=
# Parar para você aprovar o design antes de construir a interface
DESIGN_APPROVAL=true
# Plugin oficial security-guidance no builder (avisos a cada edição + revisão do diff; usa limite de uso)
ENABLE_SECURITY_GUIDANCE=true
# Qualidade mínima da suíte do test-engineer (percentual de mutantes mortos em app/services)
MIN_MUTATION_SCORE=60
MUTATION_TIMEOUT_S=1800
MAX_TEST_ROUNDS=3

# --- Limites do loop ---
MAX_FIX_ROUNDS=4
MAX_TURNS_BUILD=250
MAX_TURNS_REVIEW=120
SESSION_TIMEOUT_S=14400
RATE_LIMIT_BACKOFF_S=3600
MIN_COVERAGE=70

# --- Monitor e notificações (ntfy: instale o app e assine o tópico) ---
MONITOR_INTERVAL_S=300
MONITOR_FAILURES=3
NOTIFY_URL=

# --- Jarvis: sua central pelo app do Claude (docs/JARVIS.md) ---
# Gerados pelo ./scripts/setup-jarvis.sh. O token dá ao Jarvis o papel de operador na API interna;
# o segredo TOTP é o segundo fator que libera deploy/rollback pedidos pelo Jarvis (seu app autenticador).
JARVIS_API_TOKEN=
ADMIN_TOTP_SECRET=
# Ações da API que exigem o código do autenticador (acrescente spec,design,cancel se quiser mais rigor)
JARVIS_TOTP_FOR=deploy,rollback
# Modelo da sessão Jarvis e nome que aparece no app
JARVIS_MODEL=claude-opus-5-5
JARVIS_NAME=Jarvis
# Eventos do orquestrador empurrados em tempo real para a conversa (channels, research preview): 1 liga
JARVIS_CHANNEL=0
# Channels de chat oficiais, ex.: plugin:telegram@claude-plugins-official (veja docs/JARVIS.md)
JARVIS_CHANNELS=
# Laboratório: servidor Remote Control para abrir sessões novas pelo celular (1 liga) e quantas ao mesmo tempo
JARVIS_LAB_SERVER=1
JARVIS_LAB_CAPACITY=4
JARVIS_LAB_PERMISSION_MODE=acceptEdits
# Sessões em segundo plano criadas pelo Jarvis: dontAsk (só o que o laboratório libera) ou auto
JARVIS_BG_PERMISSION_MODE=dontAsk
# Uma conversa por projeto no app ("Jarvis · <Projeto>"): 1 liga. Cada conversa aberta usa ~300–500 MB,
# então ficam no ar os JARVIS_CONVERSAS_MAX projetos mais recentes + os FIXAS (slugs separados por vírgula)
JARVIS_CONVERSAS=1
JARVIS_CONVERSAS_MAX=6
JARVIS_CONVERSAS_FIXAS=
# conversas extras que você pode abrir no app dentro de um mesmo projeto
JARVIS_CONVERSAS_CAPACIDADE=2
JARVIS_MEM_LIMIT=6g
# O Jarvis pode PROPOR mudanças no seu Caddyfile principal; aplicar exige sempre o código do autenticador
CADDY_PROPOSALS=true
TZ=America/Sao_Paulo
