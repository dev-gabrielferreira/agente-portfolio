{
  "version": 1,
  "starter": "python-fastapi",
  "summary": "FastAPI + Jinja2/HTMX + SQLite em /data (um container)",
  "start": "python -m uvicorn app.main:app --host 127.0.0.1 --port {port}",
  "health": "/health",
  "backend": {
    "language": "python",
    "framework": "fastapi",
    "package": "app",
    "asgi": "app.main:app",
    "settings": "app.config:settings",
    "openapi": true,
    "domain": "app/services"
  },
  "frontend": null,
  "ui_paths": [
    "app/templates",
    "app/static"
  ],
  "database": "sqlite"
}
