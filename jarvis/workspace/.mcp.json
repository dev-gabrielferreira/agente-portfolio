{
  "mcpServers": {
    "agente": {
      "command": "python3",
      "args": ["-P", "-m", "jarvis.mcp_server"],
      "env": {
        "AGENTE_API_URL": "${AGENTE_API_URL:-http://agente:8080/api/v1}",
        "JARVIS_API_TOKEN": "${JARVIS_API_TOKEN}",
        "JARVIS_CHANNEL": "${JARVIS_CHANNEL:-0}",
        "JARVIS_LAB": "${JARVIS_LAB:-/srv/jarvis/lab}",
        "JARVIS_PROJECTS_DIR": "${JARVIS_PROJECTS_DIR:-/srv/projetos}",
        "JARVIS_BG_PERMISSION_MODE": "${JARVIS_BG_PERMISSION_MODE:-dontAsk}"
      }
    }
  }
}
